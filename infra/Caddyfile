{
    # Let's Encrypt account e-mail: set ACME_EMAIL in the server's .env (never in the repository)
    email {$ACME_EMAIL}
    admin off
}

# Public domain from the server's .env, for example verifica.com.br; its DNS A record points here.
{$PUBLIC_DOMAIN}, localhost {
    encode gzip zstd

    # Security headers recommended by OWASP and WCAG
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Public API and Scan Orchestrator endpoints
    handle /api/* {
        reverse_proxy scan-orchestrator:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # Research API: the research-runner checks the access cookie and the role.
    # Other /pesquisa paths (/pesquisa, /pesquisa/convite) are pages of the SPA.
    @research_api path /pesquisa/report* /pesquisa/run*
    handle @research_api {
        reverse_proxy research-runner:8004
    }

    # Accessible frontend (SPA)
    handle {
        reverse_proxy web:80
    }
}

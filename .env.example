# General environment settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Triage provider: 'fake' (deterministic default for dev/tests), 'jev' or 'gemini'
AI_PROVIDER=fake
JEV_BASE_URL=https://api.typesafe.ai
JEV_API_KEY=

# Gemini VLM (Phase 4)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ablation study (research-runner): list prices that turn measured token usage into cost.
# A model is only called by the study when its prices and the date they were read are set.
GEMINI_PRICE_INPUT_USD_PER_1M=
GEMINI_PRICE_OUTPUT_USD_PER_1M=
GEMINI_PRICE_DATE=
JEV_PRICE_USD_PER_1K_CALLS=
JEV_PRICE_DATE=
# Seconds between model calls, not counted as latency (free tiers allow few requests per minute)
RESEARCH_LLM_PAUSE_SECONDS=0

# Decision thresholds (Phase 1)
THRESHOLD_SCAM=0.90
THRESHOLD_SAFE=0.10

# Internal service URLs
AI_GATEWAY_URL=http://localhost:8001
URL_INSPECTOR_URL=http://localhost:8002
IMAGE_EXTRACTOR_URL=http://localhost:8003

# PostgreSQL database with pgvector (Docker)
# Postgres password: required by docker compose (no default on purpose)
POSTGRES_PASSWORD=
# Host port for the dev Postgres container (change it if a local PostgreSQL already uses 5432)
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://verifica:<POSTGRES_PASSWORD>@localhost:<POSTGRES_HOST_PORT>/verifica_db

# Redis Stack for cache, Bloom Filter and exact hash (Phase 2)
REDIS_URL=redis://localhost:6379/0

# uv environment outside OneDrive (optional)
# UV_PROJECT_ENVIRONMENT=C:\Users\renat\.venvs\verifica_ai

# Signing key for the anonymous device cookie ("Me explica" quota). Empty = ephemeral per-process secret
DEVICE_TOKEN_SECRET=

# Research area sign-in (R5a): Ed25519 key pair, base64. Generate with
#   uv run python -m scan_orchestrator.research_cli keygen
# Empty = nobody signs in (protected routes answer 401). The production compose requires both.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
# Dev over http://localhost: browsers accept Secure cookies on localhost, so keep it true
AUTH_COOKIE_SECURE=true
# Comma-separated list of origins allowed to call the sign-in endpoints
AUTH_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Observability (R6). Empty = telemetry off. To see traces and latency locally, start the stack with
#   docker compose -f infra/docker-compose.yml --profile observability up -d
# and set this in the shell that runs the services: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Grafana admin password: required by the production compose (no default on purpose)
GRAFANA_ADMIN_PASSWORD=
